# =============================================================================
# EXAMPLE of a completed .env — every value below is FAKE.
# It exists to show the *shape* of each value so you can tell at a glance
# whether what you pasted looks right.
#
#   .env.example         blank template, every option documented
#   .env.example.filled  <- you are here: what a real one looks like
#   .env                 the one the bot actually reads (edit this)
#
# Copy the format, not the values. Nothing here works.
# =============================================================================


# --- DISCORD -----------------------------------------------------------------

# Developer Portal -> Applications -> your app -> Bot -> Reset Token.
# Three dot-separated base64 chunks, ~70 chars. Shown exactly once — if you
# didn't copy it, reset it again. Never commit this.
DISCORD_TOKEN=REPLACE.WITH.YOUR_REAL_BOT_TOKEN

# Snowflake IDs: 17-19 digits, no quotes. Turn on Developer Mode
# (User Settings -> Advanced -> Developer Mode), then right-click to copy.
# Right-click the SERVER icon -> Copy Server ID. Comma-separate for several.
GUILD_IDS=1148273649182736450

# Right-click the VOICE CHANNEL -> Copy Channel ID. This is the 24/7 home.
VOICE_CHANNEL_ID=1148273649182736455

# Right-click YOURSELF -> Copy User ID. Owner-only commands (/active,
# /playlist add, /sync, /prune) check this list.
# The Discord app owner counts automatically; this is for adding more people.
OWNER_IDS=284917365019283746

# Optional. Right-click a TEXT channel -> Copy Channel ID. Connection warnings
# ("I can't join any voice channel") get posted here.
TEXT_CHANNEL_ID=1148273649182736460

# Optional. Right-click a ROLE in Server Settings -> Roles -> Copy Role ID.
# These can use /volume and /leave. Manage Server always counts as DJ.
DJ_ROLE_IDS=1148273649182736470,1148273649182736471

# Optional. Voice channels to try if the main one is full/forbidden/deleted,
# in order, before the bot auto-picks any channel it can join.
FALLBACK_VOICE_CHANNEL_IDS=1148273649182736456,1148273649182736457

# Leave false unless you enabled "Server Members Intent" in the Developer
# Portal. Only improves bot-vs-human detection in the voice channel.
MEMBER_INTENT=false


# --- REQUESTS ----------------------------------------------------------------
# true  = users may only request songs from playlists currently in rotation
# false = users may request anything downloaded
RESTRICT_REQUESTS_TO_ACTIVE=true


# --- PLAYLISTS ---------------------------------------------------------------
# Seeds the library on first boot. URLs or bare IDs, comma-separated.
# The ID is the part after "list=" and starts with PL / UU / LL / OL / FL.
# You can skip this entirely and use /playlist add at runtime instead.
PLAYLISTS=https://www.youtube.com/playlist?list=PLxAbCdEfGhIjKlMnOpQrStUvWxYz1234,PLzYxWvUtSrQpOnMlKjIhGfEdCbA9876


# --- STORAGE -----------------------------------------------------------------
# Docker uses /data (the mounted volume). Running bare-metal, use a path you
# can actually write — relative paths resolve from where you launch the bot.
DATA_DIR=./data
COOKIES_FILE=./data/cookies.txt


# --- PLAYBACK ----------------------------------------------------------------
VOLUME=0.5                   # 0.0-2.0; /volume overrides and persists this
IDLE_PAUSE=true              # pause when the channel has no humans
IDLE_STOP_AFTER=300          # then fully tear the stream down after 5 min,
                             # WITHOUT leaving; resumes where it stopped
RECONNECT_INTERVAL=30
WATCHDOG_INTERVAL=15
MAX_QUEUE=200


# --- DOWNLOADING -------------------------------------------------------------
AUDIO_QUALITY=192            # mp3 kbps
DOWNLOAD_CONCURRENCY=2       # higher gets you throttled by YouTube
SYNC_ON_START=true
SYNC_INTERVAL=3600           # seconds between playlist re-scans; 0 disables

LOG_LEVEL=INFO               # DEBUG while getting things working
