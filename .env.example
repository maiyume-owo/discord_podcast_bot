# ---------------------------------------------------------------- discord ---
DISCORD_TOKEN=your-bot-token

# Optional. Commands are registered in every server the bot is in, as it
# joins, so this is only needed to pre-register a server it hasn't joined yet.
GUILD_IDS=

# The 24/7 home channels — the ONLY channels the bot ever joins on its own.
# Comma separated; they may live in different servers. Where several are in the
# same server it sits in the one with listeners (it can only hold one at a
# time). If none of them exist here, the bot stays out of voice entirely and
# waits for /join. Any other channel requires /join or dragging the bot in.
VOICE_CHANNEL_IDS=

# Where the bot posts warnings (e.g. "I can't join any voice channel").
TEXT_CHANNEL_ID=

# Bot owners: the only people who can add, remove or sync playlists — that is
# the shared library, one copy for every server. Comma separated user IDs.
# The Discord application owner / team members always count as owners.
OWNER_IDS=

# Roles allowed to run DJ commands (/volume, /leave, /active — which playlists
# THIS server plays from). Manage Server also counts.
DJ_ROLE_IDS=

# Enable only if you switched on the Server Members intent in the Developer
# Portal. It just improves bot-vs-human detection in the voice channel.
MEMBER_INTENT=false

# --------------------------------------------------------------- requests ---
# true  = users may only request songs from the playlists currently in rotation
# false = users may request anything downloaded
RESTRICT_REQUESTS_TO_ACTIVE=true

# ---------------------------------------------------------------- youtube ---
# Playlist URLs or bare IDs, comma separated — seeds the library on first boot.
# The owner can also add them at runtime with /playlist add.
# WL = Watch Later, LL = Liked videos (both need cookies).
PLAYLISTS=

# Netscape-format cookie jar for private/unlisted playlists.
COOKIES_FILE=/data/cookies.txt
# Alternative for bare-metal runs: chrome, firefox, "firefox:profilename", ...

AUDIO_QUALITY=192
DOWNLOAD_CONCURRENCY=2
SYNC_ON_START=true
SYNC_INTERVAL=3600          # seconds between playlist re-scans; 0 disables

# --------------------------------------------------------------- playback ---
VOLUME=0.5                  # 0.0 - 2.0; starting level per server,
                            # then /volume per server overrides and persists
IDLE_PAUSE=true             # pause when the channel has no humans
IDLE_STOP_AFTER=300         # after this many idle seconds, tear the stream
                            # down completely (bot STAYS in the channel).
                            # Playback resumes from where it left off.
RECONNECT_INTERVAL=30
WATCHDOG_INTERVAL=15
MAX_QUEUE=200

# ---------------------------------------------------------------- storage ---
DATA_DIR=/data
LOG_LEVEL=INFO
