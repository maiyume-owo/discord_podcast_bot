# ---------------------------------------------------------------- secrets ---
# The live config: bot token, owner IDs, channel IDs. Never commit.
.env
.env.local
.env.*.local

# The templates ARE meant to be committed.
!.env.example
!.env.example.filled

# A YouTube cookie jar is a live login session for your account.
cookies.txt
*.cookies
cookies*.txt

# ------------------------------------------------------------------ state ---
# Downloaded audio, the SQLite index, and the yt-dlp cache. Large and
# reproducible — re-running /sync rebuilds all of it.
data/
/audio/
*.db
*.db-journal
*.db-wal
*.db-shm

# Stray media if DATA_DIR is pointed somewhere odd
*.mp3
*.m4a
*.webm
*.opus
*.part
*.ytdl

