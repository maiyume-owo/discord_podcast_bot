# ---------------------------------------------------------------- discord ---
DISCORD_TOKEN=your-bot-token

# Register slash commands instantly in these servers (comma separated).
# Leave empty for a global sync (can take up to an hour to appear).
GUILD_IDS=

# The 24/7 home channel. If it's missing/full/forbidden the bot falls back to
# FALLBACK_VOICE_CHANNEL_IDS, then to any voice channel it can join.
VOICE_CHANNEL_ID=
FALLBACK_VOICE_CHANNEL_IDS=

# Where the bot posts warnings (e.g. "I can't join any voice channel").
TEXT_CHANNEL_ID=

# Bot owners: the only people who can choose which playlists the bot plays
# from, and which are tracked. Comma separated user IDs.
# The Discord application owner / team members always count as owners.
OWNER_IDS=

# Roles allowed to run DJ commands (/volume, /leave). Manage Server also counts.
DJ_ROLE_IDS=

# Enable only if you switched on the Server Members intent in the Developer
# Portal. It just improves bot-vs-human detection in the voice channel.
MEMBER_INTENT=false

# --------------------------------------------------------------- requests ---
# true  = users may only request songs from the playlists currently in rotation
# false = users may request anything downloaded
RESTRICT_REQUESTS_TO_ACTIVE=true

# ---------------------------------------------------------------- youtube ---
# Playlist URLs or bare IDs, comma separated — seeds the library on first boot.
# The owner can also add them at runtime with /playlist add.
# WL = Watch Later, LL = Liked videos (both need cookies).
PLAYLISTS=

# Netscape-format cookie jar for private/unlisted playlists.
COOKIES_FILE=/data/cookies.txt
# Alternative for bare-metal runs: chrome, firefox, "firefox:profilename", ...

AUDIO_QUALITY=192
DOWNLOAD_CONCURRENCY=2
SYNC_ON_START=true
SYNC_INTERVAL=3600          # seconds between playlist re-scans; 0 disables

# --------------------------------------------------------------- playback ---
VOLUME=0.5                  # 0.0 - 2.0
IDLE_PAUSE=true             # pause when the channel has no humans
IDLE_STOP_AFTER=300         # after this many idle seconds, tear the stream
                            # down completely (bot STAYS in the channel).
                            # Playback resumes from where it left off.
RECONNECT_INTERVAL=30
WATCHDOG_INTERVAL=15
MAX_QUEUE=200

# ---------------------------------------------------------------- storage ---
DATA_DIR=/data
LOG_LEVEL=INFO
